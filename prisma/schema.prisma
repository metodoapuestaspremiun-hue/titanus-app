generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// TABLAS PREVIAS DE TITANUS GYM (CONSERVADAS 100% INTACTAS)
// -------------------------------------------------------------

model clientes {
  id                Int       @id @default(autoincrement())
  nombre            String    @db.VarChar(255)
  telefono          String?   @unique(map: "telefono") @db.VarChar(50)
  fecha_vencimiento DateTime? @db.Date
  fecha_nacimiento  DateTime? @db.Date
  deuda             Decimal?  @default(0.00) @db.Decimal(10, 2)
  inasistencias     Int?      @default(0)
  ultima_asistencia DateTime? @db.Date
  estado            String?   @default("activo") @db.VarChar(20)
  fecha_registro    DateTime? @default(now()) @db.Timestamp(0)
}

model cola_mensajes {
  id             Int       @id @default(autoincrement())
  nombre         String?   @db.VarChar(255)
  telefono       String?   @db.VarChar(50)
  tipo           String?   @db.VarChar(50)
  mensaje        String?   @db.MediumText
  estado         String?   @default("pendiente") @db.VarChar(20)
  fecha_creacion DateTime? @default(now()) @db.Timestamp(0)
  fecha_envio    DateTime? @db.Timestamp(0)
}

model configuracion {
  id                 Int       @id @default(autoincrement())
  clave              String    @unique(map: "clave") @db.VarChar(100)
  valor              String?   @db.MediumText
  descripcion        String?   @db.MediumText
  fecha_modificacion DateTime? @default(now()) @db.Timestamp(0)
}

model media {
  id             Int       @id @default(autoincrement())
  filename       String    @unique(map: "filename") @db.VarChar(255)
  content        Bytes
  mimetype       String?   @db.VarChar(100)
  fecha_creacion DateTime? @default(now()) @db.Timestamp(0)
}

// -------------------------------------------------------------
// NUEVO SISTEMA TÁCTICO: FIDELIZACIÓN, CASHBACK, QR Y COACHES
// -------------------------------------------------------------

model Tenant {
  id                      String         @id @default(uuid())
  name                    String
  slug                    String         @unique
  referralCommPct         Decimal        @default(10.00) @db.Decimal(5, 2) // % Cashback Mensualidad
  storeReferralCommPct    Decimal        @default(5.00) @db.Decimal(5, 2)  // % Cashback Tienda / Barra
  currency                String         @default("USD")
  whatsappPhone           String?
  googleReviewUrl         String?        @db.VarChar(500)
  inactivityThresholdDays Int            @default(14)
  isActive                Boolean        @default(true)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  wallets                 Wallet[]
  customers               Customer[]
  staff                   Staff[]
  evaluations             Evaluation[]
  payments                Payment[]
  qrTokens                QrToken[]
  membershipPlans         MembershipPlan[]
  walletTransactions      WalletTransaction[]
}

model Staff {
  id           String        @id @default(uuid())
  tenantId     String
  name         String
  email        String?       @unique
  passwordHash String?
  role         String        @default("TRAINER") // OWNER | TRAINER | MANAGER
  avatarUrl    String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evaluations  Evaluation[]

  @@index([tenantId])
}

model Customer {
  id               String       @id @default(uuid())
  tenantId         String
  name             String
  phone            String       // WhatsApp del socio
  membershipActive Boolean      @default(false)
  membershipExpiry DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  wallets          Wallet[]
  evaluations      Evaluation[]
  payments         Payment[]

  @@unique([tenantId, phone])
  @@index([tenantId])
}

model Wallet {
  id           String              @id @default(uuid())
  tenantId     String
  customerId   String              @unique
  balance      Decimal             @default(0.00) @db.Decimal(10, 2)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@index([tenantId])
}

model WalletTransaction {
  id          String   @id @default(uuid())
  tenantId    String
  walletId    String
  type        String   // CASHBACK_EARNED | REDEEMED | ADJUSTMENT
  amount      Decimal  @db.Decimal(10, 2)
  description String?  @db.VarChar(255)
  referenceId String?  @db.VarChar(100)
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([walletId])
}

model Payment {
  id          String    @id @default(uuid())
  tenantId    String
  customerId  String
  type        String    // MEMBERSHIP | RETAIL
  amount      Decimal   @db.Decimal(10, 2)
  cashbackPct Decimal   @db.Decimal(5, 2)
  cashbackAmt Decimal   @db.Decimal(10, 2)
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED
  approvedAt  DateTime?
  description String?   @db.VarChar(255)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
}

model Evaluation {
  id          String   @id @default(uuid())
  tenantId    String
  customerId  String
  staffId     String   // Entrenador calificado
  stars       Int      // 1 a 5
  comment     String?  @db.Text // Comentario de auditoría si es 1-4 estrellas
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
  @@index([staffId])
}

model QrToken {
  id        String   @id @default(uuid())
  tenantId  String
  type      String   // EVALUATION | MEMBERSHIP | RETAIL
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model MembershipPlan {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  price        Decimal  @db.Decimal(10, 2)
  durationDays Int      @default(30)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}
